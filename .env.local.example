# Copia este archivo a .env.local y rellena tus valores.
#
# Son los mismos tres valores que ya usa el gestor de la boda (repo `nalitos`):
# el mismo proyecto de Firebase y la misma colección `rsvps`. Si no, este sitio
# escribiría en una base de datos distinta a la que lee el gestor y las
# respuestas no llegarían a ninguna parte.
#
# A diferencia de la Access Key de JSONBin del gestor, esta config SÍ está
# pensada para ser pública: el control de acceso vive en las reglas de
# seguridad de Firestore (ver README.md > "Firebase"), no en ocultarla.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
